// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  username  String?  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile    Profile?
  projects   Project[]
  skills     Skill[]
  experience Experience[]
  education         Education[]
  portfolioSettings PortfolioSettings?
}

enum PortfolioTemplate {
  MODERN
  MINIMAL
  PROFESSIONAL
}

model PortfolioSettings {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  PortfolioTemplate @default(MODERN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  headline     String?
  bio          String?
  profileImage String?
  location     String?
  website      String?
  github       String?
  linkedin     String?
  email        String?
  phone        String?
  showEmail    Boolean  @default(false)
  showPhone    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String
  image        String?
  liveUrl      String?
  githubUrl    String?
  technologies String[]
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, displayOrder])
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Skill {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  proficiency  SkillProficiency
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([userId, displayOrder])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  SELF_EMPLOYED
  OTHER
}

model Experience {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  position       String
  employmentType EmploymentType
  location       String?
  startDate      DateTime
  endDate        DateTime?
  current        Boolean        @default(false)
  description    String?
  displayOrder   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([userId, displayOrder])
  @@index([userId, current])
}

model Education {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        String
  degree             String
  fieldOfStudy       String?
  customDegree       String?
  customFieldOfStudy String?
  location           String?
  startDate          DateTime
  endDate      DateTime?
  current      Boolean   @default(false)
  grade        String?
  description  String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([userId, displayOrder])
  @@index([userId, current])
}
