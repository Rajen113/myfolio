// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  username  String?  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile    Profile?
  projects   Project[]
  skills     Skill[]
  experience Experience[]
  education         Education[]
  portfolioSettings PortfolioSettings?
  customDomains     CustomDomain[]
  portfolioViewEvents PortfolioViewEvent[]
  contactMessages   ContactMessage[]
  resumeSettings    ResumeSettings?
}

enum PortfolioTemplate {
  MODERN
  MINIMAL
  PROFESSIONAL
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum FontFamily {
  INTER
  PLUS_JAKARTA_SANS
  DM_SANS
  MANROPE
}

enum ButtonStyle {
  ROUNDED
  PILL
  SQUARE
}

enum BorderRadius {
  SMALL
  MEDIUM
  LARGE
}

model PortfolioSettings {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        PortfolioTemplate @default(MODERN)

  themeMode       ThemeMode         @default(SYSTEM)
  themeColor      String            @default("#2563EB")
  fontFamily      FontFamily        @default(INTER)

  showAbout       Boolean           @default(true)
  showSkills      Boolean           @default(true)
  showProjects    Boolean           @default(true)
  showExperience  Boolean           @default(true)
  showEducation   Boolean           @default(true)
  showContact     Boolean           @default(true)
  showSocialLinks Boolean           @default(true)

  buttonStyle     ButtonStyle       @default(ROUNDED)
  borderRadius    BorderRadius      @default(MEDIUM)

  isPublished     Boolean           @default(false)
  publishedAt     DateTime?

  seoTitle        String?
  seoDescription  String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  viewEvents      PortfolioViewEvent[]
  contactMessages ContactMessage[]

  @@index([userId])
  @@index([userId, isPublished])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  headline     String?
  bio          String?
  profileImage String?
  location     String?
  website      String?
  github       String?
  linkedin     String?
  email        String?
  phone        String?
  showEmail    Boolean  @default(false)
  showPhone    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String
  image        String?
  liveUrl      String?
  githubUrl    String?
  technologies String[]
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, displayOrder])
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Skill {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  proficiency  SkillProficiency
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([userId, displayOrder])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  SELF_EMPLOYED
  OTHER
}

model Experience {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  position       String
  employmentType EmploymentType
  location       String?
  startDate      DateTime
  endDate        DateTime?
  current        Boolean        @default(false)
  description    String?
  displayOrder   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([userId, displayOrder])
  @@index([userId, current])
}

model Education {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        String
  degree             String
  fieldOfStudy       String?
  customDegree       String?
  customFieldOfStudy String?
  location           String?
  startDate          DateTime
  endDate      DateTime?
  current      Boolean   @default(false)
  grade        String?
  description  String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([userId, displayOrder])
  @@index([userId, current])
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

model CustomDomain {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain            String             @unique
  status            CustomDomainStatus @default(PENDING)
  verificationToken String             @unique
  isPrimary         Boolean            @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([domain])
  @@index([userId])
  @@index([domain, status])
  @@index([userId, status])
}

model PortfolioViewEvent {
  id             String            @id @default(cuid())

  portfolioId    String
  portfolio      PortfolioSettings @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  viewedAt       DateTime          @default(now())

  referrerDomain String?
  deviceType     String?
  countryCode    String?

  visitorHash    String?

  @@index([portfolioId, viewedAt])
  @@index([userId, viewedAt])
  @@index([userId, visitorHash, viewedAt])
  @@index([portfolioId, visitorHash])
}

enum ContactMessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model ContactMessage {
  id          String               @id @default(cuid())

  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  portfolioId String
  portfolio   PortfolioSettings   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  name        String
  email       String
  subject     String?
  message     String

  status      ContactMessageStatus @default(UNREAD)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([portfolioId, createdAt])
  @@index([userId, status])
}

enum ResumeTemplate {
  PROFESSIONAL
  MODERN
  MINIMAL
}

model ResumeSettings {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  template        ResumeTemplate @default(PROFESSIONAL)

  showSummary     Boolean        @default(true)
  showSkills      Boolean        @default(true)
  showExperience  Boolean        @default(true)
  showEducation   Boolean        @default(true)
  showProjects    Boolean        @default(true)
  showSocialLinks Boolean        @default(true)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
}


